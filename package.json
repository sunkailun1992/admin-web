{
  "name": "admin-web",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:test": "turbo run build:test",
    "check": "turbo run format:repo lint:repo typecheck typecheck:repo test test:repo build:dev",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "turbo run format:repo",
    "format:repo": "prettier --check .",
    "lint": "turbo run lint:repo",
    "lint:repo": "eslint . --max-warnings 0",
    "prepare": "husky",
    "test": "turbo run test test:repo",
    "test:deploy": "node scripts/verify-independent-deploy.mjs",
    "test:e2e": "playwright test",
    "test:e2e:test": "ADMIN_WEB_E2E=live playwright test",
    "test:generator": "node scripts/test-generator.mjs",
    "test:repo": "node --test \"scripts/test/*.test.mjs\"",
    "typecheck": "turbo run typecheck typecheck:repo",
    "typecheck:repo": "tsc -p e2e"
  },
  "devDependencies": {
    "@admin-web/config-eslint": "workspace:*",
    "@admin-web/config-typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  }
}
