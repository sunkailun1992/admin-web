{
  "name": "admin-web",
  "version": "1.2.2",
  "private": true,
  "description": "User center admin frontend built with Ant Design Pro and Umi Max.",
  "author": "",
  "scripts": {
    "build": "ADMIN_WEB_ENV=prod max build",
    "build:dev": "ADMIN_WEB_ENV=dev max build",
    "build:test": "ADMIN_WEB_ENV=test max build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:dev && pnpm test:e2e",
    "dev": "ADMIN_WEB_ENV=dev max dev",
    "dev:prod": "ADMIN_WEB_ENV=prod max dev",
    "dev:test": "ADMIN_WEB_ENV=test max dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "max setup",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "setup": "max setup",
    "start": "npm run dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:test": "ADMIN_WEB_E2E=live playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.15-9",
    "@antv/g6": "5.1.1",
    "@umijs/max": "^4.7.36",
    "antd": "^6.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  }
}
