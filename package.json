{
  "name": "admin-web",
  "version": "1.2.1",
  "description": "User center admin frontend built with Ant Design Pro and Umi Max.",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "author": "",
  "scripts": {
    "dev": "ADMIN_WEB_ENV=dev max dev",
    "dev:test": "ADMIN_WEB_ENV=test max dev",
    "dev:prod": "ADMIN_WEB_ENV=prod max dev",
    "build": "ADMIN_WEB_ENV=prod max build",
    "build:dev": "ADMIN_WEB_ENV=dev max build",
    "build:test": "ADMIN_WEB_ENV=test max build",
    "format": "prettier --write .",
    "postinstall": "max setup",
    "setup": "max setup",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.1",
    "@ant-design/pro-components": "^2.4.4",
    "@antv/g6": "5.1.1",
    "@umijs/max": "^4.6.56",
    "antd": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "lint-staged": "^13.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
