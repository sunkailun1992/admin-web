import type { RemoteRoutes } from '@admin-web/auth';
import { lazy, Suspense } from 'react';
import { Navigate } from 'react-router';
import './styles.css';

const ExamplePage = lazy(() => import('./pages/Example.tsx'));

const group = { key: '{{ name }}', labelKey: '{{ name }}:menu.group' };

/**
 * {{ name }} 子应用的接入契约：路由与菜单。需要权限时在 @admin-web/auth 的 access.ts 加标志位，
 * 菜单项写 access，页面外包 RequireAccess（见其他子应用的 routes.tsx）。
 */
const routes: RemoteRoutes = {
  routes: [
    { path: '/{{ name }}', element: <Navigate to="/{{ name }}/example" replace /> },
    {
      path: '/{{ name }}/example',
      element: (
        <Suspense fallback={null}>
          <ExamplePage />
        </Suspense>
      ),
    },
  ],
  menu: [
    { path: '/{{ name }}/example', labelKey: '{{ name }}:menu.example', group },
  ],
};

export default routes;
